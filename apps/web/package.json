{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "node scripts/run-next-build.js",
    "typecheck": "tsc --noEmit",
    "typecheck:app": "tsc --noEmit -p tsconfig.preflight.json",
    "start": "next start",
    "lint": "eslint . || exit 0",
    "lint:strict": "eslint .",
    "lint:fix": "eslint . --fix",
    "synthetic:bug-report": "node scripts/synthetic-bug-report.mjs",
    "synthetic:bug-report:unavailable": "SYNTHETIC_BUG_REPORT_MODE=unavailable node scripts/synthetic-bug-report.mjs",
    "test:compliance": "tsc -p tsconfig.parseComplianceTest.json && node --test .tmp/compliance-test/lib/compliance/parseComplianceError.test.js",
    "test:smoke": "vitest run",
    "test:trust": "vitest run tests/synthetic-core-loop-journeys.test.tsx --reporter=verbose",
    "synthetic:landing": "playwright test --config playwright.config.ts",
    "synthetic:auth": "playwright test --config playwright.config.ts",
    "synthetic:railway:studio-generate-80": "playwright test tests/synthetic/railway-studio-generate-80.spec.ts --config playwright.config.ts",
    "closure:railway:studio-golden-loop": "playwright test tests/synthetic/railway-studio-generate-80.spec.ts --config playwright.config.ts",
    "scan:routes": "node scripts/route-integrity-scan.mjs"
    ,
    "test": "node scripts/vitest-test.mjs"
  },
  "dependencies": {
    "framer-motion": "^12.26.2",
    "next": "16.0.10",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.0.10",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "8.48.0",
    "@typescript-eslint/parser": "8.48.0",
    "baseline-browser-mapping": "^2.10.22",
    "eslint": "^9",
    "eslint-config-next": "^16.0.10",
    "jsdom": "^27.4.0",
    "playwright": "^1.58.2",
    "tailwindcss": "^4",
    "typescript": "5.9.3",
    "vitest": "^1.6.1"
  }
}
