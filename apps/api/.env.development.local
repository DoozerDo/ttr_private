PORT=3001
# Comma-separated allowlist, e.g. http://localhost:3000,https://app.dev.targetthisrole.ai
CORS_ORIGIN=http://localhost:3000
APP_VERSION=0.1.0-dev

# For DB inside Docker you probably want:
DATABASE_URL=postgres://postgres:postgres@db:5432/targetthisrole

JWT_SECRET=super-secret-dev-key
BETA_UNLOCK_PRO=false
