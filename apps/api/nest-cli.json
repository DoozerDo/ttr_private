{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "scoring-v2/config/**/*.json",
        "outDir": "dist/apps/api/src"
      },
      {
        "include": "../templates/**/*",
        "outDir": "dist/templates"
      }
    ]
  }
}
