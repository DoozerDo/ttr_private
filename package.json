{
  "name": "targetthisrole",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:shared": "npm -w packages/shared run build",
    "build:precheck": "npm run build:api && npm -w apps/web run typecheck:app",
    "build:web": "npm -w apps/web run build",
    "build:api": "npm -w apps/api run build:verify",
    "build:both": "npm run build:shared && npm run build:api && npm run build:web",
    "build": "npm run build:both",
    "lint:web": "npm -w apps/web run lint",
    "lint:api": "npm -w apps/api run lint",
    "lint": "npm run lint:api && npm run lint:web",
    "test:api": "npm -w apps/api run test",
    "check:beta-scope": "node scripts/check-beta-scope.js",
    "synthetic:loop": "npm -w apps/api run synthetic:loop",
    "synthetic:core-loop": "npm run synthetic:loop",
    "synthetic:core-loop-smoke": "node scripts/synthetic-core-loop.mjs",
    "synthetic:bug-report": "npm -w apps/web run synthetic:bug-report",
    "synthetic:bug-report:unavailable": "npm -w apps/web run synthetic:bug-report:unavailable",
    "validate:synthetic": "npm -w apps/api run synthetic:generation",
    "verify:ci": "npm run check:beta-scope && npm run lint:api && npm run lint:web && npm run test:api && npm run build:both",
    "smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke.ps1",
    "scan:routes": "npm -w apps/web run scan:routes",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "docx": "^9.5.3",
    "patch-package": "^8.0.1"
  },
  "overrides": {
    "@typescript-eslint/eslint-plugin": "8.48.0",
    "@typescript-eslint/parser": "8.48.0"
  }
}
