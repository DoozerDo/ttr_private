+      if (!baselineTechVocabulary.has(normalized)) {
+        flags.push({
+          code: ComplianceFlagCode.FICTIONAL_TECHNOLOGY,
+          severity: ComplianceFlagSeverity.BLOCK,
+          message: `Technology "${technology}" not found in baseline.`,
+        });
+        break;
+      }
+    }
+
+    return flags;
+  }
 }
