   enforceResumeWritingRules({
     baselineSections,
     generatedSections,
   }: {
     baselineSections: Array<{ content: string; title?: string | null }>;
     generatedSections: Array<{ content: string; title?: string | null }>;
   }): ComplianceFlag[] {
     const baselineText = this.mergeText(baselineSections);
