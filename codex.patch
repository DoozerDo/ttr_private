diff --git a/apps/api/src/search-sets/search-sets.service.spec.ts b/apps/api/src/search-sets/search-sets.service.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a568c2aa10e16c4c488e099f95dd060b727bc427
