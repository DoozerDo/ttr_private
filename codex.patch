+  const clampedScore = Math.min(Math.max(score, 0), 100);
+  const offset = circumference * (1 - clampedScore / 100);
+  const gradientId = "fitReviewScoreRingGradient";
+
+  return (
+    <div
+      style={{
+        position: "relative",
