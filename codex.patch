index 0000000000000000000000000000000000000000..43dc393d40d29f5441c5e005d95d8a7a814f837f
--- /dev/null
+++ b/apps/api/src/auth/user-token.entity.ts
@@ -0,0 +1,39 @@
+import {
+  Column,
+  CreateDateColumn,
+  Entity,
+  Index,
+  JoinColumn,
+  ManyToOne,
+  PrimaryGeneratedColumn,
+} from 'typeorm';
+import { User } from '../users/user.entity';
+
+export type UserTokenType = 'confirm';
+
+@Entity({ name: 'user_tokens' })
+export class UserToken {
+  @PrimaryGeneratedColumn('uuid')
+  id!: string;
+
+  @Index()
+  @Column({ type: 'uuid' })
+  userId!: string;
+
+  @ManyToOne(() => User, { onDelete: 'CASCADE' })
+  @JoinColumn({ name: 'userId' })
+  user!: User;
+
+  @Index({ unique: true })
+  @Column({ type: 'character varying', length: 64, unique: true })
+  token!: string;
+
+  @Column({ type: 'character varying', length: 20 })
+  type!: UserTokenType;
+
+  @Column({ type: 'timestamptz' })
+  expiresAt!: Date;
+
+  @CreateDateColumn({ type: 'timestamptz' })
+  createdAt!: Date;
+}
