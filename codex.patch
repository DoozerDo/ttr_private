 function isNextRedirectError(error: unknown) {
   if (!error || typeof error !== "object") {
     return false;
   }
 
   if (!("digest" in error)) {
     return false;
   }
 
   const digest = (error as { digest?: string }).digest;
   return typeof digest === "string" && digest.startsWith("NEXT_REDIRECT");
 }
 
