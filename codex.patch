+const fetchWithRedirects = async (
+  url: string,
+  options: { redirectLimit: number; signal: AbortSignal },
+) => {
+  let currentUrl = url;
+  let redirects = 0;
+
+  while (true) {
+    const response = await fetch(currentUrl, {
+      redirect: 'manual',
+      signal: options.signal,
+    });
