diff --git a/infra/docker/api.Dockerfile b/infra/docker/api.Dockerfile
new file mode 100644
index 0000000000000000000000000000000000000000..dccc9f33ee8cb6d9e4112e2832bca9e2989a75e7
--- /dev/null
+++ b/infra/docker/api.Dockerfile
@@ -0,0 +1,25 @@
+# Builder stage installs dependencies and builds the NestJS app
+FROM node:20 AS builder
+WORKDIR /usr/src/app
+
+# Install dependencies
+COPY apps/api/package*.json ./
+RUN npm ci
+
+# Copy source and build for validation
+COPY apps/api ./
+RUN npm run build
+
+# Runtime image keeps things lightweight for development
+FROM node:20-slim AS runtime
+WORKDIR /usr/src/app
+ENV NODE_ENV=development
+
+# Bring over dependencies from the builder image
+COPY --from=builder /usr/src/app/node_modules ./node_modules
+
+# Copy the application source (overridden by bind mounts in dev)
+COPY apps/api ./
+
+EXPOSE 3001
+CMD ["npm", "run", "start:dev"]
diff --git a/infra/docker/docker-compose.dev.yml b/infra/docker/docker-compose.dev.yml
new file mode 100644
index 0000000000000000000000000000000000000000..5bfa2c3669820cda1102ea150dd2923aff8ef0e1
--- /dev/null
+++ b/infra/docker/docker-compose.dev.yml
@@ -0,0 +1,49 @@
+version: "3.9"
+
+services:
+  db:
+    image: postgres:16-alpine
+    restart: unless-stopped
+    environment:
+      POSTGRES_DB: targetthisrole
+      POSTGRES_USER: postgres
+      POSTGRES_PASSWORD: postgres
+    ports:
+      - "5432:5432"
+    volumes:
+      - db_data:/var/lib/postgresql/data
+
+  api:
+    build:
+      context: ../..
+      dockerfile: infra/docker/api.Dockerfile
+    env_file:
+      - ../../apps/api/.env.development.local
+    environment:
+      NODE_ENV: development
+    volumes:
+      - ../../apps/api:/usr/src/app
+      - /usr/src/app/node_modules
+    ports:
+      - "3001:3001"
+    depends_on:
+      - db
+
+  web:
+    build:
+      context: ../..
+      dockerfile: infra/docker/web.Dockerfile
+    env_file:
+      - ../../apps/web/.env.local
+    environment:
+      NODE_ENV: development
+    volumes:
+      - ../../apps/web:/usr/src/app
+      - /usr/src/app/node_modules
+    ports:
+      - "3000:3000"
+    depends_on:
+      - api
+
+volumes:
+  db_data:
diff --git a/infra/docker/web.Dockerfile b/infra/docker/web.Dockerfile
new file mode 100644
index 0000000000000000000000000000000000000000..a24984dfa379dfc35f1e41869980e70fa725e79a
--- /dev/null
+++ b/infra/docker/web.Dockerfile
@@ -0,0 +1,20 @@
+# Builder stage installs dependencies and runs a production build for validation
+FROM node:20 AS builder
+WORKDIR /usr/src/app
+
+COPY apps/web/package*.json ./
+RUN npm ci
+
+COPY apps/web ./
+RUN npm run build
+
+# Runtime image keeps only what's needed to run the dev server
+FROM node:20-slim AS runtime
+WORKDIR /usr/src/app
+ENV NODE_ENV=development
+
+COPY --from=builder /usr/src/app/node_modules ./node_modules
+COPY apps/web ./
+
+EXPOSE 3000
+CMD ["npm", "run", "dev", "--", "--hostname", "0.0.0.0", "--port", "3000"]
