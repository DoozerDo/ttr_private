 # docker-compose.yml (DigitalOcean runtime)
 # Uses GHCR images + Caddy reverse proxy in the proxy container.
 # Browser talks to the API via https://app.dev.../api (same origin as the web app).
 
 services:
   api:
     image: ghcr.io/targetthisrole/targetthisrole-api:dev
     restart: unless-stopped
+    env_file:
+      - ../../.env.dreamhost
     environment:
       NODE_ENV: production
       PORT: 3001
       DATABASE_URL: ${DATABASE_URL}
       CORS_ORIGIN: ${CORS_ORIGIN}
       APP_VERSION: ${APP_VERSION:-dev}
       TYPEORM_SYNCHRONIZE: "true"
     networks:
       - ttr_dev
 
   web:
     image: ghcr.io/targetthisrole/targetthisrole-web:dev
     restart: unless-stopped
     environment:
       NODE_ENV: production
       API_BASE_URL: http://api:3001
       # IMPORTANT: your proxy strips /api before forwarding to api:3001
       # so the browser must call the API through the proxy path:
       NEXT_PUBLIC_API_BASE_URL: https://${APP_DOMAIN}/api
       NEXT_PUBLIC_BETA_FORCE_PRO: "false"
       BETA_FORCE_PRO: "true"
     depends_on:
       - api
     networks:
       - ttr_dev
