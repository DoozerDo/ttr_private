#cloud-config
network:
  config: disabled
package_update: true
packages:
  - docker.io
  - docker-compose-plugin
  - python3
runcmd:
  - systemctl enable --now docker
  - mkdir -p /opt/targetthisrole
  - |
    bash -lc 'set -euo pipefail
    if ! docker compose version >/dev/null 2>&1; then
      apt-get update -y
      apt-get install -y docker-compose-plugin
    fi
    if ! docker compose version >/dev/null 2>&1; then
      mkdir -p /usr/local/lib/docker/cli-plugins
      python3 - <<'"'"'PY'"'"'
import pathlib
import urllib.request

target = pathlib.Path("/usr/local/lib/docker/cli-plugins/docker-compose")
url = "https://github.com/docker/compose/releases/download/v2.27.0/docker-compose-linux-x86_64"
with urllib.request.urlopen(url) as response, target.open("wb") as output:
    output.write(response.read())
PY
      chmod +x /usr/local/lib/docker/cli-plugins/docker-compose
    fi
    docker compose version'
