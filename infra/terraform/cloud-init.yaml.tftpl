#cloud-config
package_update: true
packages:
  - docker.io
  - docker-compose-plugin
  - nginx
  - certbot
  - python3-certbot-nginx
write_files:
  - path: /opt/targetthisrole/docker-compose.yml
    permissions: "0644"
    content: |
${indent(6, docker_compose)}
  - path: /etc/nginx/sites-available/app.dev.targetthisrole.ai.conf
    permissions: "0644"
    content: |
${indent(6, nginx_app_conf)}
  - path: /etc/nginx/sites-available/api.dev.targetthisrole.ai.conf
    permissions: "0644"
    content: |
${indent(6, nginx_api_conf)}
runcmd:
  - systemctl enable --now docker
  - usermod -aG docker ubuntu
  - mkdir -p /opt/targetthisrole
  - echo "${ghcr_token}" | docker login ghcr.io -u "${ghcr_username}" --password-stdin
  - docker compose -f /opt/targetthisrole/docker-compose.yml pull
  - docker compose -f /opt/targetthisrole/docker-compose.yml up -d
  - rm -f /etc/nginx/sites-enabled/default
  - ln -s /etc/nginx/sites-available/app.dev.targetthisrole.ai.conf /etc/nginx/sites-enabled/app.dev.targetthisrole.ai.conf
  - ln -s /etc/nginx/sites-available/api.dev.targetthisrole.ai.conf /etc/nginx/sites-enabled/api.dev.targetthisrole.ai.conf
  - nginx -t
  - systemctl enable --now nginx
  - certbot --nginx -d app.dev.targetthisrole.ai -d api.dev.targetthisrole.ai --non-interactive --agree-tos --email "${certbot_email}" --redirect
  - systemctl reload nginx
